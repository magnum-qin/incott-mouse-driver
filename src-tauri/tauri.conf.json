{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Incott Mouse Driver",
  "version": "1.0.0",
  "identifier": "com.incott.mouseapp",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Incott Mouse Driver",
        "url": "index.html",
        "width": 1080,
        "height": 720,
        "minWidth": 860,
        "minHeight": 580,
        "visible": false,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": true
      },
      {
        "label": "popover",
        "url": "popover.html",
        "width": 268,
        "height": 180,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "publisher": "magnum-qin",
    "copyright": "Copyright © 2026 magnum-qin",
    "homepage": "https://github.com/magnum-qin/incott-mouse-driver",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
